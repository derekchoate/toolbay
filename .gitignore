.claude

# ---- Operating system files ----

# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.apdisk
Icon?

# The "Icon?" rule above matches macOS's literal "Icon\r" custom-folder-icon
# file, but with core.ignorecase it also matches our own icons/ directories
# (case-insensitively, "Icon" + 1 char == "icons"). Un-ignore them explicitly.
!src-tauri/icons/
!src-tauri/icons/**

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux
.directory
.Trash-*
.nfs*
